# Neon Postgres connection string from the Neon dashboard or Vercel integration.
DATABASE_URL=postgresql://user:password@project.neon.tech/neondb?sslmode=require

# Password for the initial "Admin" account (min. 12 characters). Also replaces the
# formerly shipped default admin password, which can no longer be used to sign in.
CARECORE_ADMIN_PASSWORD=

# Name of the organization created on first start of an empty database (optional).
CARECORE_ORGANIZATION_NAME=

# CareCore KI (Assistenz und KI-Entwürfe der Pflege) – API-Schlüssel von console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini für Übersetzungsentwürfe und die Dienstplan-KI (Planung und Analyse) – API-Schlüssel aus
# Google AI Studio (aistudio.google.com). Nur serverseitig; ohne Schlüssel sind „KI-Entwürfe für fehlende Texte“
# und „Mit KI planen“ deaktiviert, alles andere läuft.
GEMINI_API_KEY=
# Optional, Standard: gemini-3.5-flash-lite
GEMINI_MODEL=

# Push-Benachrichtigungen (Web Push) – Schlüsselpaar mit `npx web-push generate-vapid-keys` erzeugen.
# Ohne diese drei Werte ist Push ausgeschaltet.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt für die Push-Dienste: mailto:… oder https://…
VAPID_SUBJECT=
# Geheimnis für den zeitgesteuerten Aufruf GET /api/push/dispatch (Authorization: Bearer …).
CRON_SECRET=
